<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle elegant tracking coordinate grid lines (UI wellness theme) -->
    <!-- Horizontal reference lines -->
    <path
        android:pathData="M18,34 H90 M18,50 H90 M18,66 H90"
        android:strokeColor="#0BFFFFFF"
        android:strokeWidth="1" />
        
    <!-- Vertical reference lines -->
    <path
        android:pathData="M34,18 V90 M50,18 V90 M66,18 V90"
        android:strokeColor="#0BFFFFFF"
        android:strokeWidth="1" />

    <!-- Minimalist Line-Art Mountains (The "Trek" background) -->
    <!-- Far Background Peak -->
    <path
        android:pathData="M44,80 L68,46 L88,80"
        android:strokeColor="#20FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Close Foreground Peak -->
    <path
        android:pathData="M20,80 L48,36 L74,80"
        android:strokeColor="#45FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The Scroll-Track Pathway winding up the mountain -->
    <path
        android:pathData="M32,76 C40,74 42,66 50,62 C58,58 54,48 64,44"
        android:strokeColor="#CCFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Glowing halo around the active trek locator point -->
    <path
        android:pathData="M 64,36 a 8,8 0 1,0 0,16 a 8,8 0 1,0 0,-16"
        android:fillColor="#33E94560" />

    <!-- Active Trek Locator Point (Accent Red) -->
    <path
        android:pathData="M 64,40 a 4,4 0 1,0 0,8 a 4,4 0 1,0 0,-8"
        android:fillColor="#E94560" />

    <!-- Minimalist Scroll-Bar Metric on the Right (representing "Scroll") -->
    <!-- Scroll-Bar Track -->
    <path
        android:pathData="M90,26 L90,82"
        android:strokeColor="#25FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- Active Scroll-Thumb (Accent Red, matching scroll position) -->
    <path
        android:pathData="M90,44 L90,60"
        android:strokeColor="#E94560"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

</vector>
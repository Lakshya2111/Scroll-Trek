<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Stylized Mountain Trek Peak -->
    <path
        android:fillColor="#E94560"
        android:fillType="nonZero"
        android:pathData="M54,28 L80,74 L28,74 Z"
        android:strokeWidth="0" />
        
    <!-- Stylized Snow Cap or Summit -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="nonZero"
        android:pathData="M54,28 L61,40 L47,40 Z"
        android:strokeWidth="0" />
        
    <!-- Stylized Left Shadow Segment -->
    <path
        android:fillColor="#22000000"
        android:fillType="nonZero"
        android:pathData="M54,28 L54,74 L28,74 Z"
        android:strokeWidth="0" />

    <!-- Scroll Chevron Up Arrow (Outer trail) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M24,84 L54,69 L84,84"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Scroll Chevron Down Arrow (glowing trail) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M24,18 L54,33 L84,18"
        android:strokeWidth="4"
        android:strokeColor="#E94560"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
        
</vector>